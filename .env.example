# Copy this file to .env.local and fill in the values.

# Your FastAPI backend (Cloud Run URL in production). No trailing slash.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Set to false to turn off sign-in (no login screens, claims use "Guest volunteer")
NEXT_PUBLIC_AUTH_ENABLED=true

# Firebase console → Project settings → Your apps → Web app config
# (these values are not secret; Firebase web config is meant to be public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=
